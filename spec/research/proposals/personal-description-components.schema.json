{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ode:experiment:personal-description-components:0.1.0",
  "title": "personal-description-components experimental contract 0.1.0",
  "description": "Experimental application output. Separate from normative ODE objects, package manifests, capture policy, authority and behavior evidence. Schema validity checks structure only.",
  "type": "object",
  "properties": {
    "format": {
      "const": "ode.experimental.personal-description-components"
    },
    "formatVersion": {
      "const": "0.1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "agentDescriptionId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "entryRoute": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependencyId": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "enum": [
              "agent_component",
              "shared_basis",
              "environment_dependency",
              "evidence"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "uri"
                ],
                "additionalProperties": false
              }
            ]
          },
          "revision": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "known",
                  "unknown"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "status",
              "value"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "known"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unknown"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "descriptionInclusion": {
            "enum": [
              "included_file",
              "external_reference"
            ]
          },
          "captureSelection": {
            "const": "not_selected"
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "accessStatus": {
            "enum": [
              "not_verified",
              "verified",
              "denied",
              "unknown"
            ]
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "derivation": {
            "type": "object",
            "properties": {
              "sourceDependencyRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "coverage": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceDependencyRefs",
              "coverage",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "dependencyId",
          "relationship",
          "purpose",
          "locator",
          "revision",
          "descriptionInclusion",
          "captureSelection",
          "basis"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "descriptionInclusion": {
                  "const": "included_file"
                }
              }
            },
            "then": {
              "required": [
                "sha256"
              ],
              "properties": {
                "locator": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "descriptionInclusion": {
                  "const": "external_reference"
                }
              }
            },
            "then": {
              "required": [
                "boundary",
                "accessStatus"
              ],
              "properties": {
                "locator": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "uri"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "methodId": {
            "type": "string",
            "minLength": 1
          },
          "dependencyRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "availability": {
            "enum": [
              "included_native_files",
              "external_reference",
              "reported_available",
              "unknown"
            ]
          },
          "selected": {
            "type": "boolean"
          },
          "applicationStatus": {
            "enum": [
              "not_run",
              "observed_use",
              "not_selected",
              "unknown"
            ]
          },
          "capabilityEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "methodId",
          "dependencyRefs",
          "availability",
          "selected",
          "applicationStatus",
          "capabilityEvidence"
        ],
        "additionalProperties": false
      }
    },
    "formalWorks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "objectId",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "formalWorkStatus": {
      "enum": [
        "not_defined",
        "defined"
      ]
    },
    "preservation": {
      "type": "object",
      "properties": {
        "descriptionOnly": {
          "const": true
        },
        "backupCreated": {
          "const": false
        },
        "capturePlan": {
          "type": "null"
        },
        "restoreStatus": {
          "const": "not_assessed"
        }
      },
      "required": [
        "descriptionOnly",
        "backupCreated",
        "capturePlan",
        "restoreStatus"
      ],
      "additionalProperties": false
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "enum": [
              "source_analysis",
              "owner_conversation",
              "standard_design"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "route",
          "question"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "version",
    "agentDescriptionId",
    "synthetic",
    "scope",
    "entryRoute",
    "dependencies",
    "methods",
    "formalWorks",
    "formalWorkStatus",
    "preservation",
    "followUps"
  ],
  "additionalProperties": false
}
