{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ode:experiment:personal-description-index:0.1.0",
  "title": "personal-description-index experimental contract 0.1.0",
  "description": "Experimental application output. Separate from normative ODE objects, package manifests, capture policy, authority and behavior evidence. Schema validity checks structure only.",
  "type": "object",
  "properties": {
    "format": {
      "const": "ode.experimental.personal-description-index"
    },
    "formatVersion": {
      "const": "0.1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "descriptionId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "draft",
        "agent_self_report",
        "owner_reviewed"
      ]
    },
    "completionMeaning": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "reflective_profile",
              "structured_composition",
              "assessment",
              "walkthrough",
              "audit",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relationship": {
            "enum": [
              "agent_component",
              "shared_basis",
              "environment_dependency",
              "evidence"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "relationship"
        ],
        "additionalProperties": false
      }
    },
    "dependencyView": {
      "type": "string",
      "minLength": 1
    },
    "backup": {
      "const": "not_created"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "version",
    "descriptionId",
    "synthetic",
    "status",
    "completionMeaning",
    "artifacts",
    "resources",
    "dependencyView",
    "backup"
  ],
  "additionalProperties": false
}
