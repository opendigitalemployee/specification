{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ode:experiment:personal-self-diagnosis:0.1.0",
  "title": "personal-self-diagnosis experimental contract 0.1.0",
  "description": "Experimental application output. Separate from normative ODE objects, package manifests, capture policy, authority and behavior evidence. Schema validity checks structure only.",
  "type": "object",
  "properties": {
    "format": {
      "const": "ode.experimental.self-diagnosis-assessment"
    },
    "formatVersion": {
      "const": "0.1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "author_assessment",
        "reviewed"
      ]
    },
    "assessedAt": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evaluator": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "checklist": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "designChecklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "fillStatus": {
            "enum": [
              "filled",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "profileRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "followUpRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "agreementStatus": {
            "enum": [
              "not_confirmed",
              "agreed"
            ]
          },
          "agreementRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "behaviorEvidence": {
            "enum": [
              "not_evaluated",
              "scoped_observation",
              "tested_with_evidence"
            ]
          },
          "behaviorEvidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "checkId",
          "fillStatus",
          "profileRefs",
          "reason",
          "followUpRefs",
          "agreementStatus",
          "agreementRefs",
          "behaviorEvidence",
          "behaviorEvidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "qualityChecklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "fillStatus": {
            "enum": [
              "filled",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "profileRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "followUpRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "agreementStatus": {
            "enum": [
              "not_confirmed",
              "agreed"
            ]
          },
          "agreementRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "behaviorEvidence": {
            "enum": [
              "not_evaluated",
              "scoped_observation",
              "tested_with_evidence"
            ]
          },
          "behaviorEvidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "checkId",
          "fillStatus",
          "profileRefs",
          "reason",
          "followUpRefs",
          "agreementStatus",
          "agreementRefs",
          "behaviorEvidence",
          "behaviorEvidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "completionCounts": {
      "type": "object",
      "properties": {
        "design": {
          "type": "object",
          "properties": {
            "filled": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "not_applicable": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "filled": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "not_applicable": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "design",
        "quality"
      ],
      "additionalProperties": false
    },
    "agreement": {
      "type": "string",
      "minLength": 1
    },
    "behavior": {
      "type": "string",
      "minLength": 1
    },
    "descriptionMaturity": {
      "const": "not_assigned"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "version",
    "status",
    "assessedAt",
    "evaluator",
    "synthetic",
    "scope",
    "profile",
    "checklist",
    "designChecklist",
    "qualityChecklist",
    "completionCounts",
    "agreement",
    "behavior",
    "descriptionMaturity"
  ],
  "additionalProperties": false
}
