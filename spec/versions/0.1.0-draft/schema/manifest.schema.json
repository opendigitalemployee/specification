{
  "type": "object",
  "required": [
    "format",
    "specVersion",
    "id",
    "version",
    "profile",
    "title",
    "entrypoints",
    "objects",
    "resources",
    "externalDependencies",
    "standards"
  ],
  "properties": {
    "format": {
      "const": "digital-employee-package"
    },
    "specVersion": {
      "const": "0.1.0-draft"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "dna",
        "environment",
        "client",
        "backup"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "entrypoints": {
      "type": "object",
      "required": [],
      "properties": {
        "dna": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "environments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "kind",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "AgentDNA",
              "Role",
              "Work",
              "Skill",
              "ToolDefinition",
              "DecisionStyle",
              "GoalMap",
              "ClientAgent",
              "ActivationBinding",
              "ToolBinding",
              "InteractionContract",
              "Policy",
              "Check",
              "Organization",
              "Environment",
              "Storage",
              "Source",
              "SourceReceipt",
              "Transformation",
              "WorldModel",
              "EntityType",
              "EntityRecord",
              "MasterData",
              "Fact",
              "DataProduct",
              "DataSnapshot",
              "CatalogIndex",
              "Connection",
              "Deployment",
              "Run",
              "Evidence",
              "ChangeSet",
              "Decision"
            ]
          },
          "path": {
            "$ref": "#/$defs/path"
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "mediaType",
          "role"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "native",
              "attachment",
              "snapshot",
              "migration",
              "editor"
            ]
          },
          "standardId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "externalDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objectId",
          "version",
          "reason"
        ],
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "revision",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "backup": {
      "type": "object",
      "required": [
        "capturedAt",
        "consistency",
        "scope",
        "missingResources",
        "resumePolicy"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "consistency": {
          "enum": [
            "quiesced",
            "best-effort"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "missingResources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resumePolicy": {
          "const": "manual"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "objectId",
        "version"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)[^\\x00]+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      }
    }
  },
  "title": "Digital employee package manifest",
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "backup"
          }
        }
      },
      "then": {
        "required": [
          "backup"
        ]
      }
    }
  ]
}
