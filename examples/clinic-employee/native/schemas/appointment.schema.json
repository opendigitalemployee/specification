{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "status",
    "hasNewAppointment"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "scheduled",
        "cancelled"
      ]
    },
    "hasNewAppointment": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
